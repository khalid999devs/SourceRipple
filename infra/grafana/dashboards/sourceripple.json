  {
   "id": 2,
   "type": "timeseries",
   "title": "Checks per minute by outcome",
   "description": "Monitor runs per minute, split by outcome (sourceripple_monitor_checks_total).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (rate(sourceripple_monitor_checks_total[5m])) * 60",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Fetch latency p50 / p95",
   "description": "Source fetch duration percentiles (sourceripple_fetch_duration_seconds histogram).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(sourceripple_fetch_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
