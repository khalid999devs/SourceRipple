# Development-only placeholder values. Use real secrets on any deployed instance.

SPRING_PROFILES_ACTIVE=local

# Compose derives these from POSTGRES_*. Elsewhere use jdbc:postgresql://<host>/<db>?sslmode=require
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sourceripple
# SPRING_DATASOURCE_USERNAME=sourceripple
# SPRING_DATASOURCE_PASSWORD=dev-db-password

PORT=8080
GIT_COMMIT=local
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError

SOURCERIPPLE_PUBLIC_BASE_URL=http://localhost:8080
# 32 random bytes, base64-encoded (openssl rand -base64 32)
SOURCERIPPLE_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
SOURCERIPPLE_ADMIN_EMAIL=admin@example.com
SOURCERIPPLE_ADMIN_PASSWORD=dev-admin-password
SOURCERIPPLE_METRICS_USERNAME=metrics
SOURCERIPPLE_METRICS_PASSWORD=dev-metrics-password
SOURCERIPPLE_TICK_TOKEN=dev-tick-token
# internal | external | both
SOURCERIPPLE_SCHEDULER_MODE=internal
SOURCERIPPLE_MIN_INTERVAL_HOURS=1
SOURCERIPPLE_FETCH_ALLOW_PRIVATE_TARGETS=true
SOURCERIPPLE_DEMO_ENABLED=true
SOURCERIPPLE_DEMO_WEBHOOK_SECRET=dev-demo-webhook-secret
SOURCERIPPLE_DEMO_USER_PASSWORD=dev-demo-user-password

POSTGRES_DB=sourceripple
POSTGRES_USER=sourceripple
POSTGRES_PASSWORD=dev-db-password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-grafana-password
